# FX-Lite environment configuration
# Copy this to .env and adjust values as needed.

# Port the HTTP server listens on (default: 3000)
PORT=3000

# Absolute path to the SQLite database file.
# In Docker, this is set to /usr/src/app/data/fxlite.db (a named volume).
# Locally, it defaults to ./data/fxlite.db relative to the project root.
DB_PATH=./data/fxlite.db

# Base URL for the Frankfurter FX API v2 (no API key required).
# v1 (api.frankfurter.app) is frozen — v2 is the current API.
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2
